# Normalize line endings on commit, keep working-copy native
* text=auto

# Windows-native files
*.nsi text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Web/source always LF
*.js text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.sh text eol=lf

# Binaries
*.png binary
*.ico binary
*.dll binary
*.exe binary
*.jar binary
